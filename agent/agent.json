            "output": 5.0,
            "cacheWrite": 1.25,
            "cacheRead": 0.1
          }
        },
        "claude-sonnet-5-5": {
          "priceUsdPerMTok": {
            "input": 2.0,
            "output": 10.0,
            "cacheWrite": 2.5,
            "cacheRead": 0.2
          },
          "effort": "low",
          "maxOutputTokens": 4000,
          "fallbacks": true
        },
        "claude-opus-5-5": {
          "priceUsdPerMTok": {
            "input": 4.0,
            "output": 20.0,
            "cacheWrite": 5.0,
