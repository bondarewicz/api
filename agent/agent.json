{
  "name": "lb-agent",
  "system": "system.md",
  "profile": "profile.json",
  "providers": {
    "ollama": {
      "model": "gemma4",
      "url": "http://localhost:11434"
    },
    "anthropic": {
      "model": "claude-sonnet-5-5",
