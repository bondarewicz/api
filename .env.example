PORT=8080
REDIS_URL=redis://localhost:6379

# Agent: "anthropic" in production; leave unset to use local Ollama (free)
# AGENT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AGENT_DAILY_BUDGET_USD=0.5
# AGENT_FALLBACK=ollama

# Braintrust traces and experiments; leave unset to send nothing
# BRAINTRUST_API_KEY=
# BRAINTRUST_PROJECT=bondarewicz

# Admin page (/v1/agent/admin); without a password the admin is off
# ADMIN_PASSWORD=

# Notifications: ntfy topic URL (or Slack/Discord webhook) and Resend email
# LEAD_WEBHOOK_URL=
# RESEND_API_KEY=
# NOTIFY_EMAIL=
# NOTIFY_FROM=bondarewicz.com <notifications@bondarewicz.com>

# Only in production, after the Cloudflare Transform Rule adds x-origin-secret
# CF_ORIGIN_SECRET=

# Spoken answers (ElevenLabs); without both the site shows no Listen button
# ELEVENLABS_API_KEY=
# ELEVENLABS_API_ENABLED=false     # switches voice off (on when unset)
# ELEVENLABS_VOICE_ID=            # the voice answers are spoken in (ID from the ElevenLabs dashboard)
# ELEVENLABS_VOICE_ID_PL=         # optional: the voice for answers given on the Polish site
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_64
# ELEVENLABS_MONTHLY_CHARS=55000
